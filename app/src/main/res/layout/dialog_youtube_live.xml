<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chọn một buổi phát sắp tới hoặc tạo buổi phát mới. Stream Key sẽ được điền kín trong ứng dụng."
        android:textColor="#AEC4D2"
        android:textSize="13sp" />

    <Spinner
        android:id="@+id/youtube_broadcast"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:contentDescription="Chọn buổi phát YouTube" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/youtube_title_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Tiêu đề buổi phát">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/youtube_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:maxLength="100"
            android:maxLines="2"
            android:text="Trực tiếp sân đấu" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/youtube_privacy_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Quyền riêng tư"
        android:textColor="#AEC4D2"
        android:textSize="13sp" />

    <Spinner
        android:id="@+id/youtube_privacy"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:contentDescription="Chọn quyền riêng tư của buổi phát" />
</LinearLayout>
