<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.YouTubeLive" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="colorPrimary">@color/brand_action</item>
        <item name="colorAccent">@color/field_label</item>
        <item name="colorSurface">@color/panel_surface</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:colorBackground">@color/panel_surface</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/field_label</item>
        <item name="android:textColorHint">@color/field_placeholder</item>
        <item name="colorControlNormal">@color/field_label</item>
        <item name="colorControlActivated">@color/field_label</item>
    </style>
    <!-- Opaque portrait host: Facebook must not inherit the landscape camera window. -->
    <style name="Theme.FacebookLogin" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
</resources>
